{
  "name": "@falorb/db",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./clickhouse": "./src/clickhouse/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "ch:migrate": "tsx src/clickhouse/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "seed": "tsx src/seed.ts",
    "seed:events": "tsx src/seed-events.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "seed:live": "tsx src/seed-live.ts",
    "seed:owner": "tsx src/seed.ts",
    "verify:workspace": "tsx src/verify-workspace.ts",
    "migrate:all": "tsx src/migrate-all.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.10.1",
    "@falorb/ai": "workspace:*",
    "@falorb/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
