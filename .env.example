# ---- Postgres (control plane: orgs, projects, persons, dashboards) ----
DATABASE_URL=postgresql://falorb:falorb@localhost:5433/falorb

# ---- ClickHouse (event firehose) ----
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=falorb
CLICKHOUSE_PASSWORD=falorb
CLICKHOUSE_DATABASE=falorb

# ---- Redis (ingest stream, job queue, caches) ----
REDIS_URL=redis://localhost:6380

# ---- URLs ----
# Collector origin. Production: https://a.example.com
FALORB_INGEST_URL=http://localhost:3001
# Dashboard origin. Production: https://analytics.example.com
FALORB_APP_URL=http://localhost:3000
# Referral link (`/r/<code>`) origin — same app as FALORB_APP_URL, distinct
# hostname so a link someone actually shares doesn't read as the internal
# dashboard's address. Falls back to FALORB_APP_URL when unset. Production:
# https://refer.example.com
FALORB_REFERRAL_URL=http://localhost:3000
# Waitlist join link (`/waitlist/[token]`) origin — same reasoning as
# FALORB_REFERRAL_URL. Falls back to FALORB_APP_URL when unset. Production:
# https://list.example.com
FALORB_WAITLIST_URL=http://localhost:3000

# ---- Secrets ----
# Base secret for the daily-rotating IP hash salt. Rotate = all anonymous
# identities reset. Must be >=32 chars. Generate: openssl rand -hex 32
FALORB_SALT_SECRET=change-me-openssl-rand-hex-32
# better-auth session signing. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32
# Envelope-encryption key for third-party integration credentials (Clay API
# keys). Required only once an org uses "Connect Clay" on /settings; blank
# makes that action fail with a clear "not configured" error rather than
# storing anything unsafely. Must be exactly 32 bytes (64 hex chars).
# Generate: openssl rand -hex 32
# Rotating this key orphans every already-encrypted credential — every
# connected org would need to reconnect Clay. Treat it like FALORB_SALT_SECRET.
FALORB_CREDENTIAL_KEY=

# ---- GeoIP ----
# MaxMind GeoLite2-City.mmdb, loaded into ingest memory at boot.
# Download with: pnpm --filter @falorb/ingest geoip:download (needs MAXMIND_LICENSE_KEY)
MAXMIND_DB_PATH=./infra/geoip/GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=

# ---- Email (Resend) ----
# Transactional email: password reset, address verification, team invites,
# email alerts. Without one of these, messages are logged instead of sent and
# email verification stays disabled so new accounts are never locked out.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Falorb <noreply@yourdomain.com>"

# Alternative to Resend: any SMTP relay. Ignored when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- B2B company enrichment (optional) ----
# Leave blank to disable IP->company lookup entirely.
IPINFO_TOKEN=

# ---- AI growth signals (optional) ----
# Powers the on-demand recommendations on a project's Signals page (content,
# product, marketing, sales), via OpenRouter's chat-completions API. Leave
# blank to disable — panels show a clear "not configured" message instead of
# failing silently. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Blank defaults to "openrouter/auto" (OpenRouter picks the best
# model per request). A single model (e.g. anthropic/claude-sonnet-4.5) pins
# it; a comma-separated list becomes an ordered fallback OpenRouter tries in
# turn if an earlier model errors or has no capacity.
OPENROUTER_MODEL=

# ---- Social listening (optional) ----
# Platform-wide Reddit app-only OAuth2 credentials (client-credentials grant),
# used to search public posts/comments against each project's prospecting
# keywords. This is one credential for the whole platform, not per-org — the
# search API needs no per-org consent. Leave blank to disable the
# reddit-listener worker job entirely (it no-ops rather than failing).
# Create an app at https://www.reddit.com/prefs/apps ("script" type is fine).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
