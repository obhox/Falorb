# --- dependencies & build output --------------------------------------------
node_modules/
dist/
build/
.next/
out/
.turbo/
coverage/

# TypeScript incremental build state. Machine-specific and rewritten on every
# build, so committing it produces a diff on every single commit.
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- secrets ------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.production
!.env.example

# --- test output --------------------------------------------------------------
# Playwright writes traces, screenshots and videos here on every run. These are
# large binaries regenerated by the next run and must never be committed.
test-results/
playwright-report/
blob-report/
.playwright-artifacts-*/
playwright/.cache/
.vitest/

# Generated per run by e2e/global-setup.ts: a throwaway @falorb.test account
# and its session cookie. Regenerated on every run, so committing them only
# produces diff noise — and a credential in git, even a disposable one against
# a local database, is a habit worth not forming.
e2e/.auth/
**/e2e/.auth/

# --- logs ---------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
lerna-debug.log*

# --- editors & OS -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# --- local data ---------------------------------------------------------------
# MaxMind databases: ~70MB, licence forbids redistribution, stale within weeks.
# Fetch with `pnpm --filter @falorb/ingest geoip:download`.
infra/geoip/*.mmdb

# Docker volume mounts and local backups.
infra/data/
infra/backups/

# Scratch files
*.tmp
.cache/
