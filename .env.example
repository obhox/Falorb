# ---- Postgres (control plane: orgs, projects, persons, dashboards) ----
DATABASE_URL=postgresql://falorb:falorb@localhost:5433/falorb

# ---- ClickHouse (event firehose) ----
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=falorb
CLICKHOUSE_PASSWORD=falorb
CLICKHOUSE_DATABASE=falorb

# ---- Redis (ingest stream, job queue, caches) ----
REDIS_URL=redis://localhost:6380

# ---- URLs ----
# Collector origin. Production: https://a.example.com
FALORB_INGEST_URL=http://localhost:3001
# Dashboard origin. Production: https://analytics.example.com
FALORB_APP_URL=http://localhost:3000
# Referral link (`/r/<code>`) origin — same app as FALORB_APP_URL, distinct
# hostname so a link someone actually shares doesn't read as the internal
# dashboard's address. Falls back to FALORB_APP_URL when unset. Production:
# https://refer.example.com
FALORB_REFERRAL_URL=http://localhost:3000
# Waitlist join link (`/waitlist/[token]`) origin — same reasoning as
# FALORB_REFERRAL_URL. Falls back to FALORB_APP_URL when unset. Production:
# https://list.example.com
FALORB_WAITLIST_URL=http://localhost:3000

# ---- Secrets ----
# Base secret for the daily-rotating IP hash salt. Rotate = all anonymous
# identities reset. Must be >=32 chars. Generate: openssl rand -hex 32
FALORB_SALT_SECRET=change-me-openssl-rand-hex-32
# better-auth session signing. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32

# ---- GeoIP ----
# MaxMind GeoLite2-City.mmdb, loaded into ingest memory at boot.
# Download with: pnpm --filter @falorb/ingest geoip:download (needs MAXMIND_LICENSE_KEY)
MAXMIND_DB_PATH=./infra/geoip/GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=

# ---- Email (Resend) ----
# Transactional email: password reset, address verification, team invites,
# email alerts. Without one of these, messages are logged instead of sent and
# email verification stays disabled so new accounts are never locked out.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Falorb <noreply@yourdomain.com>"

# Alternative to Resend: any SMTP relay. Ignored when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- B2B company enrichment (optional) ----
# Leave blank to disable IP->company lookup entirely.
IPINFO_TOKEN=

# ---- External integrations (Linki, Bund AI, Clay, Exa, Firecrawl, ElevenLabs — optional) ----
# Encrypts, at rest (AES-256-GCM), the API credentials Falorb stores for each
# connected integration. Required only once you connect one via Settings ->
# Integrations; unset, connecting fails with a clear error rather than storing
# a credential in plaintext. Must be 32 bytes of hex (64 characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Exa (neural search) and Firecrawl (page scraping) power web research —
# content drafts ground themselves in what already ranks for the topic, and
# the person profile's "Research this company" button fills in
# industry/size/LinkedIn the automatic ASN-based enrichment can't. Like Clay,
# each has one fixed API root, so connecting needs only a key, not a base
# URL. The two are fallbacks for each other, never used together for one
# request — connecting either alone is enough; the other is just the
# fallback path if the connected one errors. Get a key at
# https://dashboard.exa.ai/api-keys or https://www.firecrawl.dev/app/api-keys.
#
# ElevenLabs powers /ugc-videos (script via OPENROUTER_API_KEY below, then a
# voiceover and a lip-synced talking video via ElevenLabs' API) — each
# organization connects its own ElevenLabs account, the same as Linki/Bund
# AI/Clay, rather than Falorb sharing one platform-wide key. Nothing to set
# here beyond this encryption key; get an ElevenLabs API key at
# https://elevenlabs.io (Pro plan or above is required for API video
# generation) and connect it from Settings -> Integrations.
INTEGRATION_CREDENTIAL_ENC_KEY=

# ---- AI growth signals (optional) ----
# The deployment-wide fallback key, used by any organization that has not
# brought its own. Powers the on-demand recommendations on a project's
# Signals page (content, product, marketing, sales) and every other AI
# feature, via OpenRouter's chat-completions API. Leave blank to disable —
# panels show a clear "not configured" message instead of failing silently.
# Get a key at https://openrouter.ai/keys
#
# Organizations can bring their own AI instead, in Settings -> Integrations:
# OpenRouter (openrouter.ai) or Ramp Router (router.com), each with its own
# key, its own billing, and its own choice of model. A connected gateway
# takes precedence over this key for that organization (and a property can
# override its organization, like every other integration); this stays the
# fallback for everyone who has connected neither. Those credentials are
# stored encrypted under INTEGRATION_CREDENTIAL_ENC_KEY above, not here.
OPENROUTER_API_KEY=
# Optional, and best left blank. Applies to the fallback key above only —
# a connected gateway carries its own model, chosen in the UI. Blank means
# "openrouter/auto" — OpenRouter
# picks the best model per request, which is the intended setup for both the
# one-shot prompts (signals, digests, drafts) and the AI employees (S19).
# Agents need function calling, which not every model auto might reach for
# supports, so Falorb sends OpenRouter's `provider.require_parameters` on
# every tool-carrying request; auto then only considers models that honour
# it. A single model (e.g. anthropic/claude-sonnet-4.5) pins it instead; a
# comma-separated list becomes an ordered fallback OpenRouter tries in turn
# if an earlier model errors or has no capacity.
OPENROUTER_MODEL=
# ---- Social listening (optional) ----
# Platform-wide Reddit app-only OAuth2 credentials (client-credentials grant),
# used to search public posts/comments against each project's prospecting
# keywords. This is one credential for the whole platform, not per-org — the
# search API needs no per-org consent. Leave blank to disable the
# reddit-listener worker job entirely (it no-ops rather than failing).
# Create an app at https://www.reddit.com/prefs/apps ("script" type is fine).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
