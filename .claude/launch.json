{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "falorb-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@falorb/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "falorb-web-responsive-check",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@falorb/web",
        "exec",
        "next",
        "dev",
        "--port",
        "3010"
      ],
      "port": 3010
    }
  ]
}
