{
  "name": "@falorb/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./clickhouse": "./src/clickhouse/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "ch:migrate": "tsx src/clickhouse/migrate.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "seed:events": "tsx src/seed-events.ts",
    "seed:owner": "tsx src/seed.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.10.1",
    "@falorb/core": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
