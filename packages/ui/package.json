{
  "name": "@falorb/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.jsx",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.jsx"
    },
    "./styles.css": "./src/styles.css",
    "./tokens/*": "./src/tokens/*"
  },
  "scripts": {
