# Falorb reverse proxy.
#
# Caddy handles TLS automatically. Four hostnames, deliberately separate:
#
#   a.<domain>          the collector. Publicly reachable, high volume.
#   dashboard.<domain>  the dashboard.
#   referral.<domain>   referral links (`/r/<code>`), so a link someone
#                        actually shares doesn't read as the internal
#                        dashboard's own address. Same app as dashboard.<domain>.
#   mcp.<domain>        the MCP server, for assistants connecting remotely.
#
# The collector is on its own subdomain rather than a path on the dashboard so
# that an ad blocker rule against it cannot take the dashboard down with it,
# and so the two can be scaled and cached independently.

{
	email {$ACME_EMAIL}
	# Deployments behind Coolify already terminate TLS at the edge; uncomment
	# to let Caddy issue certificates itself instead.
	# auto_https off
}

# --- collector ---------------------------------------------------------------
a.{$FALORB_DOMAIN} {
	encode zstd gzip

	# The tracker is immutable and versioned by deploy, so it is worth caching
	# hard at the edge as well as in the browser.
	@tracker path /t.js
	header @tracker {
		Cache-Control "public, max-age=31536000, immutable"
		Access-Control-Allow-Origin "*"
	}

	# Collection endpoint. No caching, ever.
	@collect path /e /i
	header @collect Cache-Control "no-store"

	# Nothing here is authenticated by cookie, so a permissive CORS policy is
	# correct — authorisation is by project key and Origin allow-list inside
	# the app.
	header {
		-Server
		X-Content-Type-Options nosniff
	}

	reverse_proxy ingest:3001 {
		header_up X-Real-IP {remote_host}
		# The app trusts the leftmost X-Forwarded-For entry, which is only safe
		# because this proxy sets it. Do not expose ingest directly.
		header_up X-Forwarded-For {remote_host}
	}
}

# --- dashboard ---------------------------------------------------------------
dashboard.{$FALORB_DOMAIN} {
	encode zstd gzip

	# Only what Caddy uniquely owns. The security headers are set by the app
	# itself now (apps/web/next.config.mjs and src/middleware.ts) so that they
	# survive a deployment that does not use this file — which the production
	# stack does not. Setting them here too would silently override the app's,
	# including the per-request CSP nonce.
	header {
		-Server
	}

	# The dashboard serves its own auth handler and its own live stream, and
	# both must reach it rather than the account API. A blanket
	# `handle /api/*  ->  api:3003` swallowed them: `/api/live/<project>` (the
	# server-sent event stream) 404'd, and `/api/auth/*` was answered by the
	# other better-auth instance. Same origin either way, so the session cookie
	# stays first-party and needs no cross-site exemption.
	handle /api/auth/* {
		reverse_proxy web:3000
	}

	handle /api/live/* {
		reverse_proxy web:3000 {
			# Server-sent events: buffering turns a live stream into a batch
			# delivered on close.
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:3003
	}

	handle {
		reverse_proxy web:3000
	}
}

# --- referral links ------------------------------------------------------------
# Same upstream as the dashboard — `/r/[code]` is a route inside that same
# Next.js app — just a distinct public-facing hostname for shared links.
referral.{$FALORB_DOMAIN} {
	encode zstd gzip

	header {
		-Server
	}

	reverse_proxy web:3000
}

# --- MCP ---------------------------------------------------------------------
mcp.{$FALORB_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
	}

	reverse_proxy mcp:3002 {
		# MCP streams responses; buffering would defeat it.
		flush_interval -1
		# Long-lived connections for streamable HTTP.
		transport http {
			read_timeout 10m
		}
	}
}
